# Required to enable the admin dashboard. Choose a long, unique secret.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: signs admin session cookies. When unset, ADMIN_PASSWORD is used as the signing key.
# Setting it lets you rotate the password without it doubling as the signing key.
ADMIN_SESSION_SECRET=
PORT=3000

# Optional: sends registration and account-message email notifications over HTTPS.
# Without this key, verified accounts still work when Firebase is configured, but
# email alerts are unavailable. The registration notification destination is fixed in server.js.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Capital Science <onboarding@resend.dev>

# Optional: send the designed sign-in / password-reset emails from the site's own Gmail account.
# GMAIL_APP_PASSWORD is a Google "app password" (Google Account → Security → 2-Step Verification → App passwords).
# Hosts that block SMTP (Render's free plan) need the Gmail API instead: an OAuth client with the
# gmail.send scope and a refresh token for the site's Gmail. When these three are set they are used instead
# of the app password. Without any of them, Firebase's built-in plain emails are used.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Firebase Authentication + Firestore
# Web config values are public identifiers; the service account JSON is a private secret.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Phone/SMS sign-in requires Firebase's paid Blaze plan. Leave unset (hidden) unless billing is enabled.
PHONE_AUTH_ENABLED=

# Drive sync automation (GitHub Actions ⇄ site). See README "Drive sync".
# The workflow authenticates with a GitHub OIDC token, so nothing below is required.
# Optional fine-grained GitHub token (this repository only, "Actions: Read and write") so the dashboard
# Run buttons can start the workflow directly; without it they open the workflow page on GitHub.
GITHUB_DISPATCH_TOKEN=
# Optional: owner/repo if the repository moves (default Morfi28i/capital-science-faculty).
GITHUB_REPO=
# Optional shared secret the sync endpoints also accept instead of OIDC (must match the GitHub secret).
SYNC_REPORT_TOKEN=
