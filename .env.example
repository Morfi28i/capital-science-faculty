# Required to enable the admin dashboard. Choose a long, unique secret.
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000

# Optional: without SMTP settings, registrations are saved to data/registrations.jsonl
# but no notification email is sent. The destination is fixed in server.js.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Capital Science site <no-reply@example.com>
